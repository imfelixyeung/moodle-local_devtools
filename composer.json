{
    "name": "imfelixyeung/moodle-local_devkit",
    "description": "A collection of tools to help with the development of Moodle.",
    "require": {
        "php": "^8.3",
        "php-debugbar/php-debugbar": "^3.7",
        "symfony/console": "^7.0",
        "mcp/sdk": "^0.8.1",
        "symfony/process": "^7.4",
        "symfony/yaml": "^7.4",
        "symfony/finder": "^7.4",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "micaherne/phpstan-moodle": "^1.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "laravel/pint": "^1.29",
        "phpstan/phpstan-strict-rules": "^2.0",
        "rector/rector": "^2.5"
    },
    "authors": [
        {
            "name": "Felix Yeung",
            "email": "me@felixyeung.com"
        }
    ],
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3"
        }
    }
}